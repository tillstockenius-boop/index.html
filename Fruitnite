<!DOCTYPE html>
<html>
<head>
  <title>Fruitnite – Full Update 🔫</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { margin: 0; overflow: hidden; }
    canvas { display:block; }
    #hp { position: absolute; top: 10px; left: 10px; color: white; font-size: 20px; }
    #crosshair { position: absolute; top: 50%; left: 50%; width: 10px; height: 10px; margin-left:-5px; margin-top:-5px; background:white; border-radius:50%; }
    .btn { position:absolute; width:60px; height:60px; border-radius:50%; background:rgba(255,255,255,0.3); text-align:center; line-height:60px; }
    #shoot { right:15px; bottom:90px; }
    #build { right:15px; bottom:20px; }
    #joystick { position:absolute; left:15px; bottom:30px; width:100px; height:100px; background:rgba(255,255,255,0.2); border-radius:50%; }
    #gameover { position:absolute;top:0;left:0;width:100%;height:100%;background:black;color:white;display:none;justify-content:center;align-items:center;font-size:40px;flex-direction:column; }
  </style>
</head>
<body>

<div id="hp">❤️ 100</div>
<div id="crosshair"></div>
<div id="shoot" class="btn">🔫</div>
<div id="build" class="btn">🧱</div>
<div id="joystick"></div>
<div id="gameover">
  GAME OVER<br>
  <button onclick="location.reload()">Restart</button>
</div>

<script src="https://cdn.jsdelivr.net/npm/three@0.152.2/build/three.min.js"></script>
<script>

// --- Szene ---
const scene = new THREE.Scene();

// Himmel
const sky = new THREE.Mesh(
  new THREE.SphereGeometry(200, 16, 16),
  new THREE.MeshBasicMaterial({color:0x87CEEB, side: THREE.BackSide})
);
scene.add(sky);

// Kamera
const camera = new THREE.PerspectiveCamera(70, window.innerWidth/window.innerHeight, 0.1, 500);

// Renderer
const renderer = new THREE.WebGLRenderer({antialias:false});
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.BasicShadowMap;
document.body.appendChild(renderer.domElement);

// Licht
scene.add(new THREE.AmbientLight(0xffffff, 0.5));

const sun = new THREE.DirectionalLight(0xffffff, 1);
sun.position.set(10,20,10);
sun.castShadow = true;
scene.add(sun);

// Boden
const ground = new THREE.Mesh(
  new THREE.PlaneGeometry(100,100),
  new THREE.MeshStandardMaterial({color:0x3a9d23})
);
ground.rotation.x=-Math.PI/2;
ground.receiveShadow = true;
scene.add(ground);

// --- Spieler ---
const player = new THREE.Object3D();
scene.add(player);

const cameraHolder = new THREE.Object3D();
cameraHolder.position.set(0,2,0);
player.add(cameraHolder);
cameraHolder.add(camera);

let yaw=0, pitch=0;

// --- Waffe (First Person) ---
const gun = new THREE.Group();

const barrel = new THREE.Mesh(
  new THREE.BoxGeometry(0.2, 0.2, 1),
  new THREE.MeshStandardMaterial({color:0x333333})
);
barrel.position.set(0.3, -0.3, -1);

const handle = new THREE.Mesh(
  new THREE.BoxGeometry(0.2, 0.4, 0.2),
  new THREE.MeshStandardMaterial({color:0x111111})
);
handle.position.set(0.3, -0.5, -0.5);

gun.add(barrel);
gun.add(handle);
camera.add(gun);

// Kamera Steuerung
let lastX=null, lastY=null;
document.addEventListener("touchstart", e=>{
  const t=e.touches[0];
  if(t.clientX>window.innerWidth/2){lastX=t.clientX; lastY=t.clientY;}
});
document.addEventListener("touchmove", e=>{
  const t=e.touches[0];
  if(t.clientX>window.innerWidth/2 && lastX!==null){
    let dx=t.clientX-lastX;
    let dy=t.clientY-lastY;
    lastX=t.clientX; lastY=t.clientY;
    yaw-=dx*0.005; pitch-=dy*0.005;
    pitch=Math.max(-1.5, Math.min(1.5, pitch));
    player.rotation.y=yaw;
    cameraHolder.rotation.x=pitch;
  }
});
document.addEventListener("touchend", ()=>{lastX=null; lastY=null;});

// Bewegung + Kollision
let moveX=0, moveY=0;
let trees=[];

function checkCollision(newPos){
  for(let tree of trees){
    if(newPos.distanceTo(tree.position) < 1.5){
      return true;
    }
  }
  return false;
}

function move(){
  let oldPos = player.position.clone();

  player.translateZ(moveY * 0.12);
  player.translateX(moveX * 0.12);

  if(checkCollision(player.position)){
    player.position.copy(oldPos);
  }
}

// Joystick
const joystick=document.getElementById("joystick");
joystick.addEventListener("touchmove", e=>{
  const t=e.touches[0]; const r=joystick.getBoundingClientRect();
  moveX=(t.clientX-(r.left+r.width/2))/50;
  moveY=(t.clientY-(r.top+r.height/2))/50;
});
joystick.addEventListener("touchend", ()=>{moveX=0; moveY=0;});

// --- Bäume ---
function createTree(x,z){
  const tree=new THREE.Group();

  const trunk=new THREE.Mesh(
    new THREE.CylinderGeometry(0.4,0.5,2,6),
    new THREE.MeshStandardMaterial({color:0x8B4513})
  );
  trunk.position.y=1;

  const leaves=new THREE.Mesh(
    new THREE.ConeGeometry(1.5,3,6),
    new THREE.MeshStandardMaterial({color:0x1f7a1f})
  );
  leaves.position.y=3;

  tree.add(trunk);
  tree.add(leaves);

  tree.position.set(x,0,z);
  scene.add(tree);
  trees.push(tree);
}

for(let i=0;i<20;i++){
  createTree((Math.random()-0.5)*80,(Math.random()-0.5)*80);
}

// HP
let playerHP=100;

// --- Früchte ---
function createFruit(){
  const fruit = new THREE.Group();

  const types = ["apple","orange","lemon"];
  const type = types[Math.floor(Math.random()*types.length)];

  let color = 0xff3b3b;
  if(type==="orange") color = 0xffa500;
  if(type==="lemon") color = 0xffff66;

  const body = new THREE.Mesh(
    new THREE.SphereGeometry(1,6,6),
    new THREE.MeshStandardMaterial({color, roughness:0.4})
  );

  const stem = new THREE.Mesh(
    new THREE.CylinderGeometry(0.1,0.1,0.5,6),
    new THREE.MeshStandardMaterial({color:0x5c3a21})
  );
  stem.position.y=1.2;

  const leaf = new THREE.Mesh(
    new THREE.BoxGeometry(0.4,0.1,0.2),
    new THREE.MeshStandardMaterial({color:0x2ecc71})
  );
  leaf.position.set(0.2,1.3,0);

  fruit.add(body, stem, leaf);
  fruit.hp=3;

  return fruit;
}

let fruits=[];
function spawnFruit(){
  if(fruits.length>5) return;

  const f=createFruit();
  f.position.set((Math.random()-0.5)*40,1,(Math.random()-0.5)*40);

  scene.add(f);
  fruits.push(f);
}
setInterval(spawnFruit,3000);

function updateFruits(){
  const dir=new THREE.Vector3();

  fruits.forEach((f,i)=>{
    dir.subVectors(player.position,f.position).normalize();
    f.position.add(dir.multiplyScalar(0.03));
    f.rotation.y += 0.02;

    if(f.position.distanceTo(player.position)<1.5){
      playerHP-=0.2;
    }

    if(f.hp<=0){
      scene.remove(f);
      fruits.splice(i,1);
    }
  });
}

// Kugeln
let bullets=[];
document.getElementById("shoot").addEventListener("touchstart", ()=>{
  if(bullets.length>15) return;

  const b=new THREE.Mesh(
    new THREE.SphereGeometry(0.2,4,4),
    new THREE.MeshStandardMaterial({color:0xffff00})
  );

  const start=new THREE.Vector3();
  camera.getWorldPosition(start);
  b.position.copy(start);

  const dir=new THREE.Vector3();
  camera.getWorldDirection(dir);
  b.velocity=dir.multiplyScalar(1.2);

  scene.add(b);
  bullets.push(b);

  // Rückstoß
  gun.position.z = -0.2;
  setTimeout(()=>{ gun.position.z = 0; }, 100);
});

function updateBullets(){
  bullets = bullets.filter(b=>{
    b.position.add(b.velocity);

    if(b.position.length()>100){
      scene.remove(b);
      return false;
    }

    for(let f of fruits){
      if(b.position.distanceTo(f.position)<1){
        f.hp--;
        scene.remove(b);
        return false;
      }
    }
    return true;
  });
}

// Build
document.getElementById("build").addEventListener("touchstart", ()=>{
  const wall=new THREE.Mesh(
    new THREE.BoxGeometry(2,2,0.5),
    new THREE.MeshStandardMaterial({color:0x8B4513})
  );

  const dir=new THREE.Vector3(0,0,-5);
  dir.applyQuaternion(player.quaternion);

  wall.position.copy(player.position).add(dir);
  wall.position.y=1;

  scene.add(wall);
});

// UI
function updateUI(){
  document.getElementById("hp").innerText="❤️ "+Math.floor(playerHP);
  if(playerHP<=0){
    document.getElementById("gameover").style.display="flex";
    cancelAnimationFrame(loop);
  }
}

// Fullscreen
function goFullscreen(){
  if(document.documentElement.requestFullscreen){
    document.documentElement.requestFullscreen();
  }
}
document.body.addEventListener("touchstart", goFullscreen, {once:true});

// Resize
window.addEventListener("resize", ()=>{
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

// Loop
let loop;
function animate(){
  loop=requestAnimationFrame(animate);
  move();
  updateBullets();
  updateFruits();
  updateUI();
  renderer.render(scene,camera);
}
animate();

</script>
</body>
</html>
